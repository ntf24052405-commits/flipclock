<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Flip Clock"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTask" android:label="Flip Clock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:exported="true"
            android:label="Flip Clock Settings"
            android:theme="@android:style/Theme.Material.Light"/>
        <receiver android:name=".AutomationReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.sachin.flipclock.SET"/>
                <action android:name="com.sachin.flipclock.RESET"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
